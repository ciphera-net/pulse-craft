{#
  Pulse Analytics settings.

  Rendered by Plugin::settingsHtml() at Settings -> Plugins -> Pulse Analytics.
  `settings` is the Settings model (src/models/Settings.php); its own
  validators attach field errors to it, which `forms.textField()` reads via
  `errors:` the same way every other Craft settings screen does.
#}
{% import '_includes/forms' as forms %}

<p>
  {{ 'This plugin adds {pulse} to your site with a script under 3 KB. Pulse sets no cookies and never stores IP addresses. You need a Pulse account with a site registered for the same domain.'|t('pulse-analytics', {
    pulse: '<a href="https://pulse.ciphera.net" target="_blank" rel="noopener">Pulse Analytics</a>',
  })|raw }}
</p>

{{ forms.textField({
  label: 'Domain'|t('pulse-analytics'),
  instructions: "Enter the domain this site is registered under in Pulse, for example `example.com`. If you leave it empty, the tracker uses the browser's own hostname, which is right for a site served on one domain."|t('pulse-analytics'),
  id: 'domain',
  name: 'domain',
  value: settings.domain,
  errors: settings.getErrors('domain'),
}) }}

{{ forms.lightswitchField({
  label: 'Record clicks, copies and form submits'|t('pulse-analytics'),
  instructions: 'This adds a second script as a separate request, so your pages only load it when you switch this on.'|t('pulse-analytics'),
  id: 'companion',
  name: 'companion',
  on: settings.companion,
}) }}

{{ forms.textField({
  label: 'Custom API origin'|t('pulse-analytics'),
  instructions: 'If you route events through your own proxy, enter its origin here, for example `https://example.com`. Enter the origin only, without a path, because the tracker adds its own. Leave this empty if you have not set up a proxy.'|t('pulse-analytics'),
  id: 'apiOrigin',
  name: 'apiOrigin',
  value: settings.apiOrigin,
  errors: settings.getErrors('apiOrigin'),
}) }}

<p class="light">
  {{ 'The plugin never adds the script to the control panel, and no setting changes that.'|t('pulse-analytics') }}
</p>
